---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." sidebar>
  <section class="lost">
    <p class="code" aria-hidden="true">404</p>
    <h1>Page not found</h1>
    <p>This page drifted out of the frame of reference. Try one of these instead.</p>
    <p class="actions">
      <a class="button primary" href={withBase()}>Homepage</a>
      <a class="button" href={withBase('library')}>Library</a>
    </p>
  </section>
</BaseLayout>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: 2rem 0;
    text-align: center;
    background: radial-gradient(50% 40% at 50% 40%, var(--ph-accent-soft), transparent 70%);
  }
  .code {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(5rem, 22vw, 10rem);
    line-height: 1;
    color: var(--ph-accent-text);
    opacity: 0.85;
  }
  h1 {
    margin: 0.5rem 0 0;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ph-text-strong);
  }
  p {
    margin: 0.75rem 0 0;
    max-width: 28rem;
    color: var(--ph-muted);
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    margin-block-start: 1.75rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.6rem 1.4rem;
    border: 1px solid var(--ph-border);
    border-radius: 999px;
    color: var(--ph-text);
    font-weight: 500;
    text-decoration: none;
  }
  .button:hover {
    border-color: var(--ph-accent);
    background: var(--ph-hover);
  }
  .button:focus-visible {
    outline: 2px solid var(--ph-accent);
    outline-offset: 3px;
  }
  .button.primary {
    border-color: var(--ph-accent);
    background: var(--ph-accent);
    color: #fff;
  }
</style>

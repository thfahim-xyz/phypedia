---
/**
 * Semantic figure with caption. Centered by default; `align="right"` floats it
 * to the right with text wrapping (stacks on narrow screens).
 *
 * <Figure src={import('./diagram.svg')} …> is NOT needed: import the asset in MDX
 *   import diagram from './diagram.svg';
 *   <Figure src={diagram} alt="…" caption="…" />
 * A plain string path (e.g. "/images/x.png" from public/) also works.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  align?: 'center' | 'right';
  /** Maximum rendered width, any CSS length (e.g. "24rem"). */
  width?: string;
}

const { src, alt, caption, align = 'center', width } = Astro.props;
const style = width ? `--figure-width: ${width}` : undefined;
---

<figure class:list={['figure', align]} style={style}>
  {typeof src === 'string' ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : <Image src={src} alt={alt} />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    --figure-width: 100%;
    margin: 1.75rem auto;
    max-width: var(--figure-width);
    text-align: center;
  }
  .figure :is(img, svg) {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    border-radius: 0.4rem;
  }
  figcaption {
    margin-block-start: 0.6rem;
    color: var(--ph-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  @media (min-width: 45rem) {
    .right {
      float: right;
      width: min(var(--figure-width), 45%);
      margin: 0.35rem 0 1rem 1.75rem;
    }
  }
</style>

---
/**
 * Recursive navigation list used by both sidebar modes. Groups are native
 * <details> elements (keyboard accessible, no framework); the group containing
 * the current page is always open.
 */
import type { NavItem } from '../lib/site';
import Self from './NavTree.astro';

interface Props {
  items: NavItem[];
  /** Pathname of the page being viewed (trailing slash). */
  current: string;
}

const { items, current } = Astro.props;

const contains = (item: NavItem): boolean =>
  item.href === current || (item.children ?? []).some(contains);
---

<ul class="nav-list">
  {
    items.map((item) =>
      item.children?.length ? (
        <li>
          <details
            open={contains(item)}
            data-nav-key={item.key}
            data-current={contains(item) ? '' : undefined}
          >
            <summary>
              <span>{item.title}</span>
            </summary>
            <Self items={item.children} current={current} />
          </details>
        </li>
      ) : (
        <li>
          {item.href ? (
            <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
              {item.title}
            </a>
          ) : (
            <span class="label">{item.title}</span>
          )}
        </li>
      ),
    )
  }
</ul>

<style>
  .nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Nested lists get a quiet guide line instead of heavy indentation. */
  .nav-list .nav-list {
    margin-inline-start: 0.65rem;
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--ph-border);
  }
  a,
  summary,
  .label {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.3rem 0.65rem;
    border-radius: 0.5rem;
    color: var(--ph-muted);
    font-size: 0.925rem;
    line-height: 1.35;
    text-decoration: none;
  }
  a,
  summary {
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  a:hover,
  summary:hover {
    color: var(--ph-text);
    background: var(--ph-hover);
  }
  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--ph-accent);
    outline-offset: -2px;
  }
  a[aria-current='page'] {
    color: var(--ph-accent-text);
    background: var(--ph-accent-soft);
    font-weight: 500;
  }
  summary {
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--ph-text);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
    opacity: 0.6;
  }
  details[open] > summary::after {
    transform: rotate(45deg);
  }
</style>

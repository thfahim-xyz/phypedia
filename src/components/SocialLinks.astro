---
import { Icon } from '@astrojs/starlight/components';
import { SITE } from '../lib/config';

interface Props {
  /** Show the platform name next to each icon (used on the About page). */
  labels?: boolean;
}

const { labels = false } = Astro.props;
---

<ul class:list={['socials', { labelled: labels }]}>
  {
    SITE.socials.map((social) => (
      <li>
        <a
          href={social.href}
          aria-label={labels ? undefined : social.label}
          rel="me noopener"
          target={social.href.startsWith('mailto:') ? undefined : '_blank'}
        >
          <Icon name={social.icon} size="1.25rem" />
          {labels && <span>{social.label}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 2.5rem;
    min-height: 2.5rem;
    justify-content: center;
    padding-inline: 0.5rem;
    border-radius: 0.5rem;
    color: var(--ph-muted);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  a:hover {
    color: var(--ph-text);
    background: var(--ph-hover);
  }
  a:focus-visible {
    outline: 2px solid var(--ph-accent);
    outline-offset: 2px;
  }
  .labelled {
    flex-direction: column;
    gap: 0;
  }
  .labelled a {
    justify-content: flex-start;
    padding-inline: 0.5rem 1rem;
  }
</style>
